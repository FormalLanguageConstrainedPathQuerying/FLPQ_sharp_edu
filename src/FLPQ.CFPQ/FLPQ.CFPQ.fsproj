<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>FS3569</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CfpqInput.fs" />
    <Compile Include="CfpqSemiring.fs" />
    <Compile Include="AzimovCfpq.fs" />
    <Compile Include="KroneckerCfpq.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FLPQ.LinearAlgebra\FLPQ.LinearAlgebra.fsproj" />
    <ProjectReference Include="..\FLPQ.GraphAnalysis\FLPQ.GraphAnalysis.fsproj" />
    <ProjectReference Include="..\FLPQ.Languages\FLPQ.Languages.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharpPlus" Version="1.9.1" />
  </ItemGroup>

</Project>
