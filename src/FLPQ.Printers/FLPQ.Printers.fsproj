<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MatrixTeX.fs" />
    <Compile Include="TeXRenderer.fs" />
    <Compile Include="DerivationTreeDot.fs" />
    <Compile Include="AutomatonDot.fs" />
    <Compile Include="CykTeX.fs" />
    <Compile Include="ValiantTeX.fs" />
    <Compile Include="LLTableTeX.fs" />
    <Compile Include="LRTableTeX.fs" />
    <Compile Include="LLStepVisualizer.fs" />
    <Compile Include="LRStepVisualizer.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FLPQ.LinearAlgebra\FLPQ.LinearAlgebra.fsproj" />
    <ProjectReference Include="..\FLPQ.Languages\FLPQ.Languages.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharpPlus" Version="1.9.1" />
  </ItemGroup>

</Project>
