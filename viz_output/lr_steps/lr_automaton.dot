digraph Automaton {
  rankdir=LR;
  s0 [style=filled, fillcolor=green, label="State 0"];
  s1 [label="State 1"];
  s2 [peripheries=2, label="State 2"];
  s3 [label="State 3"];
  s4 [label="State 4"];
  s5 [label="State 5"];
  s0 -> s1 [label="T (Terminal \"a\")"];
  s0 -> s2 [label="N (Nonterminal \"S\")"];
  s1 -> s1 [label="T (Terminal \"a\")"];
  s1 -> s3 [label="N (Nonterminal \"S\")"];
  s3 -> s4 [label="T (Terminal \"b\")"];
  s4 -> s1 [label="T (Terminal \"a\")"];
  s4 -> s5 [label="N (Nonterminal \"S\")"];
}
