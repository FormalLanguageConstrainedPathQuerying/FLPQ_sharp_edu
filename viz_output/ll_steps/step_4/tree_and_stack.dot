digraph StackTree {
  rankdir=TB;
  n1 [label="N (Nonterminal \"S\")"];
  n2 [label="T (Terminal \"a\")", shape=box];
  n1 -> n2;
  n3 [label="T (Terminal \"a\")", shape=box];
  n1 -> n3;
  n4 [label="N (Nonterminal \"S\")", shape=box];
  n5 [label="T (Terminal \"b\")", shape=box];
  n6 [label="N (Nonterminal \"S\")", shape=box];
  n7 [label="T (Terminal \"b\")", shape=box];
  n8 [label="N (Nonterminal \"S\")", shape=box];
  n4 -> n5 [style=dashed, constraint=false];
  n5 -> n6 [style=dashed, constraint=false];
  n6 -> n7 [style=dashed, constraint=false];
  n7 -> n8 [style=dashed, constraint=false];
  {rank=same; n4; n5; n6; n7; n8}
}
