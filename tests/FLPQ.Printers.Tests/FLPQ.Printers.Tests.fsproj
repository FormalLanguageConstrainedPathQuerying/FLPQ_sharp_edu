<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GoldenHelpers.fs" />
    <Compile Include="ExternalToolsTests.fs" />
    <Compile Include="MatrixTeXTests.fs" />
    <Compile Include="AutomatonVisualizationTests.fs" />
    <Compile Include="DerivationTreeVisualizationTests.fs" />
    <Compile Include="LLVisualizerTests.fs" />
    <Compile Include="LRVisualizerTests.fs" />
    <Compile Include="GrammarTeXGoldenTests.fs" />
    <Compile Include="LRTableTeXGoldenTests.fs" />
    <Compile Include="CykSummaryGoldenTests.fs" />
    <Compile Include="LLStepsGoldenTests.fs" />
    <Compile Include="LRStepsGoldenTests.fs" />
    <Compile Include="LLTableTeXGoldenTests.fs" />
    <Compile Include="ValiantTraceGoldenTests.fs" />
    <Compile Include="PathIndexTeXTests.fs" />
    <Compile Include="TexCompilationTests.fs" />
    <Compile Include="GssDotTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\tex_tikz_template.tex">
      <Link>tex_tikz_template.tex</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\tex_template.tex">
      <Link>tex_template.tex</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\tex_tabular_template.tex">
      <Link>tex_tabular_template.tex</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\tex_summary_template.tex">
      <Link>tex_summary_template.tex</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\example_grammar.bnf">
      <Link>example_grammar.bnf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\example_input.txt">
      <Link>example_input.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GoldenData\*.tex">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GoldenData\*.dot">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FSharpPlus" Version="1.9.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FLPQ.Printers\FLPQ.Printers.fsproj" />
    <ProjectReference Include="..\..\src\FLPQ.Languages\FLPQ.Languages.fsproj" />
    <ProjectReference Include="..\..\src\FLPQ.LinearAlgebra\FLPQ.LinearAlgebra.fsproj" />
    <ProjectReference Include="..\FLPQ.TestUtilities\FLPQ.TestUtilities.fsproj" />
  </ItemGroup>

</Project>
