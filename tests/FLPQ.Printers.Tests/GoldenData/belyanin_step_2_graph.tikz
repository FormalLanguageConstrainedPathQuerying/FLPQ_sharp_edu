\begin{tikzpicture}
  \graph [layered layout, nodes={draw, circle}, grow'=right, level sep=2cm, sibling sep=1.5cm] {
    v0 [as={$v_0$}, fill=yellow!20];
    v1 [as={$v_1$}, fill=yellow!20];
    v2 [as={$v_2$}];
    v3 [as={$v_3$}];
    v4 [as={$v_4$}];
    v5 [as={$v_5$}];
    v0 ->["a", red] v1;
    v1 ->["b"] v2;
    v2 ->["c"] v3;
    v2 ->["a"] v5;
    v3 ->["b"] v2;
    v3 ->["a"] v4;
  };
\end{tikzpicture}
