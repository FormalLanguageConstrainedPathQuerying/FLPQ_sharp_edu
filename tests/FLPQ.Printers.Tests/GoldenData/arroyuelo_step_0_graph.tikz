\begin{tikzpicture}
  \flpqdotmeasureedgelabel{v0->v1}{a}
  \flpqdotmeasureedgelabel{v1->v2}{b}
  \flpqdotmeasureedgelabel{v1->v3}{a}
  \flpqdotmeasureedgelabel{v2->v3}{a}
  \graph [dot layout, nodes={draw, circle}, grow'=right, level sep=2cm, sibling sep=1.5cm] {
    v0 [as={$v_0$}, fill=yellow!20];
    v1 [as={$v_1$}, fill=yellow!20];
    v2 [as={$v_2$}, fill=yellow!20];
    v3 [as={$v_3$}, fill=yellow!20];
    v0 ->[red, thick] v1;
    v1 ->[red, thick] v2;
    v1 ->[red, thick] v3;
    v2 ->[red, thick] v3;
  };
\end{tikzpicture}
