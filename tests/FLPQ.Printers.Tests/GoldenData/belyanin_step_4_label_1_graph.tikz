\begin{tikzpicture}
  \flpqdotmeasureedgelabel{v0->v1}{a}
  \flpqdotmeasureedgelabel{v1->v2}{b}
  \flpqdotmeasureedgelabel{v2->v3}{c}
  \flpqdotmeasureedgelabel{v2->v5}{a}
  \flpqdotmeasureedgelabel{v3->v2}{b}
  \flpqdotmeasureedgelabel{v3->v4}{a}
  \graph [dot layout, nodes={draw, circle}, grow'=right, level sep=2cm, sibling sep=1.5cm] {
    v0 [as={$v_0$}, fill=green!30];
    v1 [as={$v_1$}];
    v2 [as={$v_2$}];
    v3 [as={$v_3$}, fill=lightblue!20];
    v4 [as={$v_4$}];
    v5 [as={$v_5$}];
    v0 ->[red!40] v1;
    v1 ->[red!40] v2;
    v2 ->[red!40] v3;
    v2 ->[red!40] v5;
    v3 ->[red, thick] v2;
    v3 -> v4;
  };
\end{tikzpicture}
