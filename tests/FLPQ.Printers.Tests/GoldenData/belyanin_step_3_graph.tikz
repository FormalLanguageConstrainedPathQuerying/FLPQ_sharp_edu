\begin{tikzpicture}
  \graph [layered layout, nodes={draw, circle}, grow'=right, level sep=2cm, sibling sep=1.5cm] {
    v0 [as={$v_0$}];
    v1 [as={$v_1$}];
    v2 [as={$v_2$}, fill=yellow!20];
    v3 [as={$v_3$}, fill=yellow!20];
    v4 [as={$v_4$}];
    v5 [as={$v_5$}, fill=yellow!20];
    v0 ->["a", red!40] v1;
    v1 ->["b", red!40] v2;
    v2 ->["c", red, thick, bend left=15] v3;
    v2 ->["a", red, thick] v5;
    v3 ->["b", bend left=15] v2;
    v3 ->["a"] v4;
  };
\end{tikzpicture}
